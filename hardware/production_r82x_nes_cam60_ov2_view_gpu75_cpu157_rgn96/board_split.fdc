define_attribute {p:sd_mosi} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:sd_miso} {PAP_IO_DIRECTION} {INPUT}

# task13: reuse mature rate30 AI asynchronous group. Actual u_pose contains
# 2-FF Gray counters/toggles, held snapshots and dual-clock result RAM;
# camera -> AI uses p2_async_fifo. This is not camera clock/pin signoff.
# Source: references/pose_generated/p2_board_hdmi.fdc, ai_clk async group.
set_clock_groups -name ai_clk -asynchronous -group [get_clocks {ai_clk}]


# task15: physical ports now connected to the mature CAM2 front end.
# Native camera1 is module CAM2 on MINI J10.
