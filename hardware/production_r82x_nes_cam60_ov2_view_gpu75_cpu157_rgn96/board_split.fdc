# 10ns is NOT a verified sensor PCLK. No fabricated external IO delays.
create_clock -name camera_clk_1 [get_ports camera_clk_1] -period 8.400 -waveform {0 4.2}
# Independent module oscillator; ready levels and the existing Gray FIFO cross.
set_clock_groups -name camera_clk_1 -asynchronous -group [get_clocks {camera_clk_1}]

