define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rx} {PAP_IO_NONE} {TRUE}

# Actual task8 AI PLL, unchanged. External camera I/O timing remains provisional.
create_generated_clock -name {ai_clk} -source [get_ports {sys_clk}] [get_pins {u_ai_pll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {36} -divide_by {8}

# task13: same-board vendor Ethernet attributes, pin/voltage/standard checked before merge.
define_attribute {p:phy_reset_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:phy_reset_n} {PAP_IO_DRIVE} {8}
define_attribute {p:phy_reset_n} {PAP_IO_SLEW} {SLOW}
