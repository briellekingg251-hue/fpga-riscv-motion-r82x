# Fruit Ninja demo -- PG2L200H FBB676 (Pango 200K MINI) + 7" 1024x600 RGB LCD
# LCD pins/IO attributes: 7-inch TFT reference design LCD.fdc (unchanged).
# clock / key / UART / LED: sealed CPU mini.fdc (ports renamed clk->sys_clk, key0_n->sys_rst_n).

create_clock -name sys_clk [get_ports sys_clk] -period 37.037 -waveform {0.000 18.5185}
create_generated_clock -name {cpu_clk} -source [get_ports {sys_clk}] [get_pins {pll162/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {35} -divide_by {6}
create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_pins {pllvid/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {256} -divide_by {135}
# CPU <-> pixel domain crossings are gray-coded FIFO pointers and 2-FF synchronisers
# The wrapper's GMII/DDR clock now comes from the PHY-referenced PLL, as in the
# verified recorder constraints; keep its source and output in one clock group.
# Phase from task12 native DRC-2018: required waveform {0.625 4.625 8.625}.
create_clock -name {ref_clk} [get_ports {clk_p}] -period {8.0} -waveform {0 4.0}
create_generated_clock -name {rst_clk} -source [get_ports {clk_p}] [get_pins {u_ddr/u_ddrphy_top/rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {clk_p}] [get_pins {u_ddr/u_ddrphy_top/ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {clk_p}] [get_pins {u_ddr/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_ddr/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_p}] [get_pins {u_ddr/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_ddr/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_ddr/u_ddrphy_top/ddrphy_slice_top/i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
create_generated_clock -name {gpu_clk} -source [get_ports {sys_clk}] [get_pins {gpu_pll/clkout1}] -master_clock [get_clocks {sys_clk}] -multiply_by {36} -divide_by {13}
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]
# DDR3 controller clocks are asynchronous to the CPU (fn_ddr_bridge: gray-pointer FIFOs).
set_clock_groups -name cpu_pix_async -asynchronous -group [get_clocks {gpu_clk}] -group [get_clocks {cpu_clk}] -group [get_clocks {pix_clk}] -group [get_clocks {sys_clk}] -group [get_clocks {ref_clk ddrphy_sysclk phy_dq_sysclk_0 phy_dq_sysclk_1}]

