define_attribute {i:u_pose/ai/pose_net/layer14} {PAP_REGION} {platform_top}
define_attribute {v:fn_cpu_core} {syn_hier} {hard}
define_attribute {i:u_pose/ai/crop} {PAP_REGION} {crop_region}
define_attribute {i:hdmi_tx} {PAP_REGION} {platform_top}

# HDMI release FFs beside the IOLHR_16_y serializer pairs (probe hdmi_loc_probe02).
define_attribute {i:hdmi_tx/encoder[0].dataserializer/serial_reset/ready} {PAP_LOC} {CLMA_21_678:FF0}
define_attribute {i:hdmi_tx/encoder[1].dataserializer/serial_reset/ready} {PAP_LOC} {CLMA_21_702:FF0}
define_attribute {i:hdmi_tx/encoder[2].dataserializer/serial_reset/ready} {PAP_LOC} {CLMA_21_726:FF0}
define_attribute {i:hdmi_tx/clockserializer/serial_reset/ready} {PAP_LOC} {CLMA_21_750:FF0}
define_attribute {i:hdmi_tx/serial_release/ready[0]} {PAP_LOC} {CLMA_21_714:FF0}
define_attribute {i:hdmi_tx/serial_release/ready[1]} {PAP_LOC} {CLMA_21_714:FF1}
define_attribute {i:hdmi_tx/serial_release/ready[2]} {PAP_LOC} {CLMA_21_714:FF2}
define_attribute {i:u_sys/u_gpu/gpu/u_raster/u_bg} {PAP_REGION} {platform_right}

set_max_skew 7.5 -from [get_clocks {ai_clk}] -to [get_pins -hierarchical -regexp {^view/write_fifo/wgray_s1(\[[0-9:]+\])?/D(\[[0-9]+\])?$}]

set_max_skew 7.5 -from [get_clocks {ddrphy_sysclk}] -to [get_pins -hierarchical -regexp {^view/write_fifo/rgray_s1(\[[0-9:]+\])?/D(\[[0-9]+\])?$}]

set_max_skew 12.5 -from [get_clocks {hdmi_clk}] -to [get_pins -hierarchical -regexp {^view/request_fifo/wgray_s1(\[[0-9:]+\])?/D(\[[0-9]+\])?$}]

set_max_skew 7.5 -from [get_clocks {ddrphy_sysclk}] -to [get_pins -hierarchical -regexp {^view/request_fifo/rgray_s1(\[[0-9:]+\])?/D(\[[0-9]+\])?$}]

set_max_skew 7.5 -from [get_clocks {ddrphy_sysclk}] -to [get_pins -hierarchical -regexp {^view/response_fifo/wgray_s1(\[[0-9:]+\])?/D(\[[0-9]+\])?$}]

set_max_skew 12.5 -from [get_clocks {hdmi_clk}] -to [get_pins -hierarchical -regexp {^view/response_fifo/rgray_s1(\[[0-9:]+\])?/D(\[[0-9]+\])?$}]

