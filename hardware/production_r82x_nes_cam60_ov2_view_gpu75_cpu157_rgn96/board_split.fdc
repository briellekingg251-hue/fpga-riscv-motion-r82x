define_attribute {i:u_pose/ai/pose_net/layer8/dot/page[0].column[3].tap[8].cell_pe} {PAP_REGION} {platform_top}
# R70: HDMI lane reset release (pixel-clock negedge FF) -> GTP_OSERDES_E2 RST. The release
# arrives after the first SERCLK rising edge and is captured on the next one
# (evidence/hdmi_sync_reset_probe01); removal vs the first edge, the OCLK falling-edge and the
# OCLKDIV checks remain single-cycle.
set_multicycle_path 2 -setup -from [get_pins -hierarchical -regexp {^hdmi_tx/(clockserializer|encoder\[[0-2]\]\.dataserializer)/serial_reset/ready/CLK$}] -rise_to [get_clocks {hdmi_clk5}]
set_multicycle_path 1 -hold -from [get_pins -hierarchical -regexp {^hdmi_tx/(clockserializer|encoder\[[0-2]\]\.dataserializer)/serial_reset/ready/CLK$}] -rise_to [get_clocks {hdmi_clk5}]
